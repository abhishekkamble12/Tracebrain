# Copy to .env and fill in. Never commit .env.
# $0 budget: Groq free tier only.
LLM_PROVIDERS=groq

# console.groq.com/keys  (fastest; ~200K tokens/day on gpt-oss-120b)
GROQ_API_KEY=

# Optional model overrides (defaults in tracebrain/config.py)
# GROQ_AGENT_MODEL=openai/gpt-oss-120b

TRACEBRAIN_LLM_CACHE=1
FALKOR_HOST=localhost
# Host port of FalkorDB. docker-compose.yml publishes it here too; change it if 6379 is taken
# (e.g. by a plain Redis, which can't run graph queries).
FALKOR_PORT=6379
FALKOR_BROWSER_PORT=3000

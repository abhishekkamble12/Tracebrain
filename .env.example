# Copy to .env and fill in. Never commit .env.
# All three LLM providers have free tiers; you need at least one key. Order = fallback order.
LLM_PROVIDERS=groq,cerebras,gemini

# console.groq.com/keys  (fastest; ~200K tokens/day on gpt-oss-120b)
GROQ_API_KEY=
# cloud.cerebras.ai  (1M tokens/day, 5 requests/min; good for eval runs)
CEREBRAS_API_KEY=
# aistudio.google.com/apikey  (last-resort fallback)
GEMINI_API_KEY=

# Optional model overrides (defaults in tracebrain/config.py)
# GROQ_AGENT_MODEL=openai/gpt-oss-120b
# CEREBRAS_AGENT_MODEL=gpt-oss-120b
# GEMINI_AGENT_MODEL=gemini-flash-latest

TRACEBRAIN_LLM_CACHE=1
FALKOR_HOST=localhost
FALKOR_PORT=6379

# Copy to .env and fill in. Never commit .env.
# $0 budget: Groq free tier only.
LLM_PROVIDERS=groq

# console.groq.com/keys  (fastest; ~200K tokens/day on gpt-oss-120b)
GROQ_API_KEY=

# Optional model overrides (defaults in tracebrain/config.py)
# GROQ_AGENT_MODEL=openai/gpt-oss-120b

TRACEBRAIN_LLM_CACHE=1
FALKOR_HOST=localhost
FALKOR_PORT=6379
